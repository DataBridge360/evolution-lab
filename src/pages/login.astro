---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ingresar — Evolution Chemical SRL">
  <div class="login-page">

    <div class="login-left">
      <div class="login-left-inner">
        <a href="/" class="login-logo">
          <img src="/assets/images/logo-2.png" alt="Evolution Chemical SRL" height="44" />
        </a>
        <div class="login-brand">
          <h1>Evolution<br/>Chemical</h1>
          <p>Laboratorio de Análisis Industriales de Alta Calidad para la industria petrolera de Neuquén.</p>
        </div>
        <div class="login-tagline">
          <span class="login-dot"></span>
          Certificado ISO 9001:2015
        </div>
      </div>
    </div>

    <div class="login-right">
      <div class="login-box">

        <div class="login-header">
          <h2>Iniciá sesión</h2>
          <p>Accedé a tu cuenta de Evolution Chemical</p>
        </div>

        <form class="login-form" method="POST" action="/api/login">
          <div class="login-field">
            <label for="email">Usuario o email</label>
            <input
              type="text"
              id="email"
              name="email"
              required
              placeholder="tu@email.com"
              autocomplete="username"
            />
          </div>
          <div class="login-field">
            <label for="password">Contraseña</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••••"
              autocomplete="current-password"
            />
          </div>
          <button type="submit" class="login-submit">
            Ingresar
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>

        <p class="login-back"><a href="/">← Volver al sitio</a></p>

      </div>
    </div>

  </div>
</Layout>

<style>
.login-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
}

/* ── LEFT PANEL ─────────────────────────────────────── */
.login-left {
  background: var(--navy);
  position: relative;
  overflow: hidden;
}
.login-left::before {
  content: '';
  position: absolute;
  bottom: -120px; right: -120px;
  width: 480px; height: 480px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,99,10,.18), transparent 70%);
  pointer-events: none;
}
.login-left::after {
  content: '';
  position: absolute;
  top: -80px; left: -80px;
  width: 360px; height: 360px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(37,99,235,.12), transparent 70%);
  pointer-events: none;
}

.login-left-inner {
  position: relative; z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 52px 60px;
}

.login-logo { display: inline-flex; margin-bottom: auto; }

.login-brand {
  margin: auto 0 48px;
}
.login-brand h1 {
  font-size: clamp(2.4rem, 4vw, 3.6rem);
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -.04em;
  color: #fff;
  margin-bottom: 20px;
}

.login-brand p {
  font-size: .95rem;
  color: rgba(255,255,255,.45);
  line-height: 1.72;
  max-width: 320px;
}

.login-tagline {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: rgba(255,255,255,.3);
}
.login-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--orange);
  box-shadow: 0 0 8px rgba(232,99,10,.7);
  flex-shrink: 0;
}

/* ── RIGHT PANEL ────────────────────────────────────── */
.login-right {
  background: var(--gray-50);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 40px;
}

.login-box {
  width: 100%;
  max-width: 400px;
}

.login-header {
  margin-bottom: 36px;
}
.login-header h2 {
  font-size: 1.9rem;
  font-weight: 800;
  letter-spacing: -.03em;
  color: var(--navy);
  margin-bottom: 8px;
}
.login-header p {
  font-size: .9rem;
  color: var(--gray-400);
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.login-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.login-field label {
  font-size: .82rem;
  font-weight: 600;
  color: var(--navy);
}
.login-field input {
  background: #fff;
  border: 1.5px solid rgba(11,31,58,.12);
  border-radius: 10px;
  padding: 14px 16px;
  font-family: var(--font);
  font-size: 1rem;
  color: var(--navy);
  outline: none;
  width: 100%;
  transition: border-color .2s, box-shadow .2s;
}
.login-field input::placeholder { color: rgba(11,31,58,.22); }
.login-field input:focus {
  border-color: var(--orange);
  box-shadow: 0 0 0 3px rgba(232,99,10,.09);
}

.login-submit {
  margin-top: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  background: var(--orange);
  color: #fff;
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 700;
  padding: 15px;
  border-radius: 100px;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 20px rgba(232,99,10,.3);
  transition: background .2s, transform .15s, box-shadow .2s;
}
.login-submit:hover {
  background: var(--orange-light);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(232,99,10,.45);
}

.login-back {
  margin-top: 28px;
  text-align: center;
  font-size: .85rem;
  color: var(--gray-400);
}
.login-back a {
  color: var(--navy);
  font-weight: 600;
  text-decoration: none;
  transition: color .2s;
}
.login-back a:hover { color: var(--orange); }

/* ── RESPONSIVE ─────────────────────────────────────── */
@media (max-width: 768px) {
  .login-page { grid-template-columns: 1fr; }
  .login-left { min-height: 220px; }
  .login-left-inner { padding: 36px 28px; }
  .login-brand { margin: 24px 0 0; }
  .login-tagline { display: none; }
  .login-right { padding: 40px 24px; }
}
</style>
