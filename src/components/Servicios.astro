---
const servicios = [
  {
    n: "01", cat: "Campo", color: "orange",
    titulo: "Asistencia en Campo",
    desc: "Visualización, interpretación y asesoramiento técnico ante problemáticas inherentes a los distintos sistemas implicados, determinando su origen y proyección.",
    tags: ["Diagnóstico in situ", "Asesoramiento técnico"],
    img: "/assets/images/service/service-7.jpg",
  },
  {
    n: "02", cat: "Campo", color: "orange",
    titulo: "Desarrollo en Sistema de Control",
    desc: "Orientado al estudio de corrosión, incrustación, biocompetición y mecánica de fluidos para optimizar el rendimiento de los sistemas productivos.",
    tags: ["Corrosión", "Incrustación", "Biocompetición", "Fluidos"],
    img: "/assets/images/service/service-8.jpg",
  },
  {
    n: "03", cat: "Campo", color: "orange",
    titulo: "Monitoreo y Muestreo en Instalaciones",
    desc: "Plantas de tratamiento de crudo, agua, gas y pozos petroleros. Cobertura integral de todas las instalaciones de producción.",
    tags: ["Crudo", "Agua", "Gas", "Pozos petroleros"],
    img: "/assets/images/service/service-9.jpg",
  },
  {
    n: "04", cat: "Laboratorio", color: "blue",
    titulo: "Análisis Fisicoquímicos y Microbiológicos",
    desc: "Análisis básico de agua, tendencia incrustante, potabilidad, gases disueltos (O₂, CO₂, SH₂), metales, sulfuros, iones, bacterias por método ATP, hidrocarburos y sólidos en suspensión.",
    tags: ["Agua", "O₂ CO₂ SH₂", "Bacterias ATP", "Metales"],
    img: "/assets/images/service/service-4.jpg",
    detalles: [
      "Análisis básico de agua",
      "Análisis de tendencia incrustante, compatibilidad de aguas",
      "Análisis de potabilidad y microbiológico bajo el código alimentario argentino",
      "Determinación de gases disueltos en agua: O₂, CO₂, SH₂",
      "Metales por absorción atómica",
      "Determinación de Sulfuros totales y disueltos",
      "Determinación iones específicos bajo normativa inherente",
      "Determinación de residuales y eficiencia de productos químicos",
      "Determinación de bacterias por método ATP, extinción o cultivo",
      "Determinación de HC por espectrofotómetro o IR",
      "Tamaño de distribución de partículas",
      "Determinación de sólidos en suspensión, índice de taponamiento"
    ]
  },
  {
    n: "05", cat: "Laboratorio", color: "blue",
    titulo: "Análisis de Crudo",
    desc: "Saturados, aromáticos, resinas y asfáltenos, viscosidad, gravedad API, densidad, destilación, pour point, TAN, azufre, sales, Flash point, Cold finger y Bottle test.",
    tags: ["Gravedad API", "Viscosidad", "Bottle test", "TAN"],
    img: "/assets/images/service/service-5.jpg",
    detalles: [
      "Determinación de saturados, aromáticos, resinas y asfáltenos",
      "Análisis cromatográfico líquido",
      "Viscosidad",
      "Índice de viscosidad",
      "Punto de inflamación",
      "Insolubles en pentano / Insolubles en tolueno",
      "Contenido de humedad (KF)",
      "Pour Point",
      "Punto de turbidez",
      "Densidad",
      "Curva de destilación",
      "Gravedad API",
      "Determinación de %Agua y sedimentos",
      "Determinación del número de acidez TAN",
      "Determinación de azufre por combustión",
      "Determinación de sales",
      "Determinación SSFF en oil",
      "Flash point, Cloud point",
      "Ensayo Cold finger",
      "Ensayos Bottle test"
    ]
  },
  {
    n: "06", cat: "Laboratorio", color: "blue",
    titulo: "Análisis de Sólidos",
    desc: "Caracterización por DRX, FX, microscopía de barrido electrónico (SEM) y granulometría de sólidos.",
    tags: ["DRX", "FX", "SEM", "Granulometría"],
    img: "/assets/images/service/service-6.jpg",
  },
  {
    n: "07", cat: "Laboratorio", color: "blue",
    titulo: "Calidad y Eficiencia de Productos Químicos",
    desc: "Evaluación de inhibidores de corrosión, incrustación, biocidas, floculantes, dispersantes de parafinas, reductores de fricción, desemulsionantes y espumígenos.",
    tags: ["Inhibidores", "Biocidas", "Floculantes", "Desemulsionantes"],
    img: "/assets/images/service/service-10.jpg",
  },
  {
    n: "08", cat: "Laboratorio", color: "blue",
    titulo: "Análisis de Muestras Gaseosas",
    desc: "Análisis cromatográfico y determinación de contaminantes en gas natural y asociado.",
    tags: ["Cromatografía", "Gas natural", "Contaminantes"],
    img: "/assets/images/service/service-11.jpg",
