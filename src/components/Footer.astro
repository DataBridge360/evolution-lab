<footer class="ft">

  <!-- top gradient divider -->
  <div class="ft-divider" aria-hidden="true"></div>

  <div class="ft-inner">

    <!-- col 1: brand -->
    <div class="ft-brand">
      <a href="/" class="ft-logo">
        <img src="/assets/images/logo-2.png" alt="Evolution Chemical SRL" height="48" />
      </a>
      <p class="ft-tagline">
        Laboratorio de análisis industriales con más de 25 años al servicio
        de la industria petrolera de Neuquén.
      </p>
      <div class="ft-socials">
        <!-- placeholder links — replace hrefs when social profiles exist -->
        <a href="mailto:info@evolution-chemical.net" class="ft-social" aria-label="Email">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </a>
        <a href="https://wa.me/5492994867613" class="ft-social" aria-label="WhatsApp">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- col 2: navegación -->
    <div class="ft-col">
      <p class="ft-col-title">Navegación</p>
      <ul class="ft-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#quienes-somos">Quiénes somos</a></li>
        <li><a href="#servicios">Nuestros servicios</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>

    <!-- col 3: servicios destacados -->
    <div class="ft-col">
      <p class="ft-col-title">Servicios</p>
      <ul class="ft-links">
        <li><a href="#servicios">Análisis de aguas</a></li>
        <li><a href="#servicios">Análisis de gases</a></li>
        <li><a href="#servicios">Petróleo crudo</a></li>
        <li><a href="#servicios">Inhibidores</a></li>
        <li><a href="#servicios">Fluidos de yacimiento</a></li>
        <li><a href="#servicios">Estudio de corrosión</a></li>
      </ul>
    </div>

    <!-- col 4: contacto -->
    <div class="ft-col ft-col--contact">
      <p class="ft-col-title">Contacto</p>
      <ul class="ft-contact-list">
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <a href="mailto:info@evolution-chemical.net">info@evolution-chemical.net</a>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Cutral-Có — Manuel Sabio 278, Neuquén</span>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Rincón de los Sauces — Puesto Cofré s/n, Neuquén</span>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 12a19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 3.05 1.1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.96a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/>
          </svg>
          <span>299 486 7613 / 299 452 7591</span>
        </li>
      </ul>
    </div>

  </div>

  <!-- bottom bar -->
  <div class="ft-bottom">
    <div class="ft-bottom-inner">
      <p class="ft-copy">
        © <span id="ft-year"></span> Evolution Chemical S.R.L. Todos los derechos reservados.
      </p>
      <p class="ft-neuquen">Neuquén, Argentina</p>
    </div>
  </div>

</footer>

<style>

/* ─── FOOTER ──────────────────────────────────── */
.ft {
  background: var(--navy);
  position: relative;
  z-index: 2;
}

.ft-divider {
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(232,99,10,.35) 30%,
    rgba(232,99,10,.35) 70%,
    transparent 100%
  );
}

/* ─── INNER GRID ──────────────────────────────── */
.ft-inner {
  max-width: 1200px; margin: 0 auto;
  padding: 72px 80px 60px;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.6fr;
  gap: 56px;
}

/* ─── BRAND ───────────────────────────────────── */
.ft-logo img {
  height: 48px; width: auto;
  opacity: .85;
  transition: opacity .2s;
}
.ft-logo:hover img { opacity: 1; }

.ft-tagline {
  font-size: .85rem;
  color: rgba(255,255,255,.38);
  line-height: 1.78;
  margin-top: 20px;
  max-width: 260px;
}

.ft-socials {
  display: flex; gap: 10px;
  margin-top: 28px;
}
.ft-social {
  width: 36px; height: 36px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,.45);
  transition: background .2s, border-color .2s, color .2s;
}
.ft-social:hover {
  background: rgba(232,99,10,.15);
  border-color: rgba(232,99,10,.35);
  color: var(--orange);
}

/* ─── COLUMNS ─────────────────────────────────── */
.ft-col-title {
  font-size: .68rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .12em;
  color: rgba(255,255,255,.35);
  margin-bottom: 22px;
}

.ft-links { display: flex; flex-direction: column; gap: 11px; }
.ft-links li a {
  font-size: .85rem;
  color: rgba(255,255,255,.45);
  transition: color .2s;
}
.ft-links li a:hover { color: #fff; }

/* ─── CONTACT LIST ────────────────────────────── */
.ft-contact-list {
  display: flex; flex-direction: column; gap: 14px;
}
.ft-contact-list li {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: .82rem; color: rgba(255,255,255,.42);
  line-height: 1.55;
}
.ft-contact-list li svg {
  flex-shrink: 0; margin-top: 2px;
  opacity: .55;
}
.ft-contact-list li a {
  color: rgba(255,255,255,.42);
  transition: color .2s;
}
.ft-contact-list li a:hover { color: var(--orange); }

/* ─── BOTTOM BAR ──────────────────────────────── */
.ft-bottom {
  border-top: 1px solid rgba(255,255,255,.06);
}
.ft-bottom-inner {
  max-width: 1200px; margin: 0 auto;
  padding: 22px 80px;
  display: flex; align-items: center; justify-content: space-between;
}
.ft-copy, .ft-neuquen {
  font-size: .78rem;
  color: rgba(255,255,255,.25);
}

/* ─── RESPONSIVE ──────────────────────────────── */
@media (max-width: 1024px) {
  .ft-inner {
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    padding: 60px 48px 48px;
  }
  .ft-brand { grid-column: 1 / -1; }
}

@media (max-width: 640px) {
  .ft-inner {
    grid-template-columns: 1fr 1fr;
    gap: 32px 16px;
    padding: 44px 24px 36px;
  }
  .ft-brand { grid-column: 1 / -1; }
  .ft-tagline { font-size: .8rem; margin-top: 14px; max-width: 100%; }
  .ft-socials { margin-top: 18px; }
  .ft-col-title { margin-bottom: 14px; }
  .ft-links { gap: 10px; }
  .ft-links li a { font-size: .8rem; }
  .ft-col--contact { display: none; }
  .ft-bottom-inner { padding: 16px 24px; flex-direction: column; gap: 4px; text-align: center; }
}

</style>

<script>
document.getElementById('ft-year')!.textContent = String(new Date().getFullYear());
</script>
